# ---------------------------------------------------------------------------
# Data is NEVER committed. Everything under data/ is ignored, including the
# raw vendor files, interim artefacts and processed feature stores.
# Reproducibility comes from src/data/*.py + docs/data_inventory.md, not from
# checked-in bytes. Only .gitkeep files survive so the tree shape is preserved.
# ---------------------------------------------------------------------------
data/**
!data/
!data/raw/
!data/interim/
!data/processed/
!data/**/.gitkeep

# Secrets / API keys (EPC ODC key, Elexon key, CDS key)
.env
.env.*
!.env.example
.cdsapirc
secrets/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.python-version

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
htmlcov/
.coverage
.coverage.*

# Notebooks: keep the .ipynb, drop the heavyweight exports
notebooks/**/*.html
notebooks/**/*.pdf

# Reports: figures and tables are regenerated by `make report`
reports/figures/
reports/tables/
!reports/.gitkeep

# OS / editor
.DS_Store
.idea/
.vscode/
