# ---------------------------------------------------------------------------
# Data is NEVER committed. Everything under data/ is ignored, including the
# raw vendor files, interim artefacts and processed feature stores.
# Reproducibility comes from src/data/*.py + docs/data_inventory.md, not from
# checked-in bytes. Only .gitkeep files survive so the tree shape is preserved.
# ---------------------------------------------------------------------------
data/**
!data/
!data/raw/
!data/interim/
!data/processed/
!data/**/.gitkeep

# Secrets / API keys (EPC ODC key, Elexon key, CDS key)
.env
.env.*
!.env.example
.cdsapirc
secrets/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.python-version

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
htmlcov/
.coverage
.coverage.*

# Notebooks: keep the .ipynb, drop the heavyweight exports
notebooks/**/*.html
notebooks/**/*.pdf

# Reports: tables are regenerated by the pipeline and stay out of git.
# The headline figures are an exception -- they are the published result and a
# reader should not have to run a 40-minute pipeline to see them.
reports/tables/
reports/figures/*
!reports/figures/phase1_error_by_season.png
!reports/figures/phase1_error_by_period.png
!reports/figures/phase1_residual_scatter.png
!reports/figures/phase1b_mae_by_ldz.png
!reports/figures/phase1b_ng_error_vs_cwv.png
!reports/figures/phase1b_power_curve.png
!reports/.gitkeep

# OS / editor
.DS_Store
.idea/
.vscode/
